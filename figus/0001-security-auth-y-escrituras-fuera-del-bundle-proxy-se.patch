@@ -0,0 +1,28 @@
+import { readJson, sendJson } from '../lib/server/auth.js'
+import { readFromSheets, writeToSheets } from '../lib/server/sheets.js'
+
+// Endpoints públicos: solo lectura por slug y contador de vistas.
+export default async function handler(req, res) {
+  try {
+    if (req.method === 'GET') {
+      const slug = new URL(req.url, 'http://localhost').searchParams.get('slug')
+      if (!slug) return sendJson(res, 400, { error: 'Falta el slug' })
+      const event = await readFromSheets('getBySlug', { slug })
+      return sendJson(res, 200, event)
+    }
+
+    if (req.method === 'POST') {
+      const body = await readJson(req)
+      if (body.action !== 'incrementViews' || !body.slug) {
+        return sendJson(res, 400, { error: 'Acción no permitida' })
+      }
+      const data = await writeToSheets('incrementViews', { slug: body.slug })
+      return sendJson(res, 200, { views: data.views })
+    }
+
+    return sendJson(res, 405, { error: 'Método no permitido' })
+  } catch (error) {
+    console.error('invitations:', error.message)
+    return sendJson(res, 502, { error: error.message })
+  }
+}
diff --git a/lib/server/auth.js b/lib/server/auth.js
new file mode 100644
index 0000000..9bda455
--- /dev/null
+++ b/lib/server/auth.js
@@ -0,0 +1,65 @@
+import crypto from 'node:crypto'
+
+const COOKIE_NAME = 'if_admin'
+const SESSION_HOURS = 8
+
+const secret = () => process.env.SESSION_SECRET || 'dev-secret-change-me'
+
+export function createSessionToken() {
+  const payload = Buffer.from(
+    JSON.stringify({ admin: true, exp: Date.now() + SESSION_HOURS * 3600 * 1000 }),
+  ).toString('base64url')
+  const signature = crypto.createHmac('sha256', secret()).update(payload).digest('base64url')
+  return `${payload}.${signature}`
+}
+
+export function isAdminRequest(req) {
+  const cookies = (req.headers.cookie || '').split(';').map((item) => item.trim())
+  const token = cookies.find((item) => item.startsWith(`${COOKIE_NAME}=`))?.slice(COOKIE_NAME.length + 1)
+  if (!token) return false
+  const [payload, signature] = token.split('.')
+  if (!payload || !signature) return false
+  const expected = crypto.createHmac('sha256', secret()).update(payload).digest('base64url')
+  const a = Buffer.from(signature)
+  const b = Buffer.from(expected)
+  if (a.length !== b.length || !crypto.timingSafeEqual(a, b)) return false
+  try {
+    const data = JSON.parse(Buffer.from(payload, 'base64url').toString('utf8'))
+    return data.admin === true && data.exp > Date.now()
+  } catch {
+    return false
+  }
+}
+
+export function setSessionCookie(res, token) {
+  const secure = process.env.NODE_ENV === 'production' ? '; Secure' : ''
+  res.setHeader(
+    'Set-Cookie',
+    `${COOKIE_NAME}=${token}; HttpOnly; SameSite=Strict; Path=/; Max-Age=${SESSION_HOURS * 3600}${secure}`,
+  )
+}
+
+export function clearSessionCookie(res) {
+  res.setHeader('Set-Cookie', `${COOKIE_NAME}=; HttpOnly; SameSite=Strict; Path=/; Max-Age=0`)
+}
+
+export async function readJson(req) {
+  if (req.body && typeof req.body === 'object') return req.body
+  let raw = ''
+  for await (const chunk of req) raw += chunk
+  if (!raw) return {}
+  try { return JSON.parse(raw) } catch { return {} }
+}
+
+export function sendJson(res, status, data) {
+  res.statusCode = status
+  res.setHeader('Content-Type', 'application/json; charset=utf-8')
+  res.end(JSON.stringify(data))
+}
+
+export function passwordMatches(provided, expected) {
+  if (typeof provided !== 'string' || !expected) return false
+  const a = Buffer.from(provided)
+  const b = Buffer.from(expected)
+  return a.length === b.length && crypto.timingSafeEqual(a, b)
+}
diff --git a/lib/server/sheets.js b/lib/server/sheets.js
new file mode 100644
index 0000000..ff7488f
--- /dev/null
+++ b/lib/server/sheets.js
@@ -0,0 +1,53 @@
+const READ_ACTIONS = new Set(['getAll', 'getBySlug'])
+const WRITE_ACTIONS = new Set(['updateStatus', 'deleteRow', 'updateField', 'incrementViews'])
+
+function scriptUrl() {
+  if (!process.env.APPS_SCRIPT_URL) {
+    throw new Error('APPS_SCRIPT_URL no configurada en el servidor')
+  }
+  return process.env.APPS_SCRIPT_URL
+}
+
+async function withTimeout(signalFn) {
+  const controller = new AbortController()
+  const timer = setTimeout(() => controller.abort(), 15000)
+  try {
+    return await signalFn(controller.signal)
+  } finally {
+    clearTimeout(timer)
+  }
+}
+
+export async function readFromSheets(action, params = {}) {
+  if (!READ_ACTIONS.has(action)) throw new Error('Acción de lectura no permitida')
+  const url = new URL(scriptUrl())
+  url.searchParams.set('action', action)
+  Object.entries(params).forEach(([key, value]) => {
+    if (value !== undefined && value !== null) url.searchParams.set(key, String(value))
+  })
+  const response = await withTimeout((signal) => fetch(url, { signal, redirect: 'follow' }))
+  const data = await response.json()
+  if (!data.success) throw new Error(data.error || 'Error al leer Google Sheets')
+  return data.data
+}
+
+export async function writeToSheets(action, params = {}) {
+  if (!WRITE_ACTIONS.has(action)) throw new Error('Acción de escritura no permitida')
+  const body = new URLSearchParams()
+  Object.entries(params).forEach(([key, value]) => {
+    body.set(key, value === undefined || value === null ? '' : String(value))
+  })
+  const response = await withTimeout((signal) => fetch(`${scriptUrl()}?action=${action}`, {
+    method: 'POST',
+    redirect: 'follow',
+    credentials: 'omit',
+    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+    body,
+    signal,
+  }))
+  const data = await response.json()
+  if (!data.success) throw new Error(data.error || 'Error al escribir en Google Sheets')
+  return data
+}
+
+export { READ_ACTIONS, WRITE_ACTIONS }
