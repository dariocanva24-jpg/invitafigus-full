+// Normaliza el nombre que viene de Google Sheets al id del equipo.
+export function teamIdFromName(name = '') {
+  const normalized = name
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '')
+  return getTeamById(normalized)?.id || normalized || 'argentina'
+}
